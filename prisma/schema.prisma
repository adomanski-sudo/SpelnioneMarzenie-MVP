// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// MODELE APLIKACJI 
// ------------------------------------------------------

enum DreamCategory {
  CZAS      // Wspólnie spędzony czas
  POMYSL    // Ogólny pomysł na prezent
  KONKRET   // Konkretny model/link
  USMIECH   // Drobiazgi wywołujące radość
}

enum Visibility {
  PUBLIC    // Widoczne dla każdego (nawet bez logowania)
  PRIVATE   // Widoczne tylko dla zalogowanych znajomych
}

model Dream {
  id            String        @id @default(cuid())
  title         String
  description   String?       @db.Text
  category      DreamCategory
  visibility    Visibility    @default(PUBLIC)
  isFulfilled   Boolean       @default(false)
  link          String?       // Link do sklepu/produktu

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relacja: Kto jest autorem marzenia?
  authorId      String
  author        User          @relation("UserDreams", fields: [authorId], references: [id], onDelete: Cascade)

  // Relacja: Kto zarezerwował marzenie?
  // Właściciel marzenia nigdy nie dowie się o zawartości tego pola na frontendzie!
  reservedById  String?
  reservedBy    User?         @relation("UserReservations", fields: [reservedById], references: [id], onDelete: SetNull)
}

// ------------------------------------------------------
// MODELE AUTH.JS (NIEZBĘDNE DO LOGOWANIA I UŻYTKOWNIKÓW)
// ------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // --- Twoje własne relacje ---
  
  // Marzenia, które użytkownik dodał na swój profil
  dreams        Dream[]   @relation("UserDreams")
  
  // Marzenia innych, które użytkownik zarezerwował do spełnienia
  reservations  Dream[]   @relation("UserReservations")
  
  // Relacja znajomych (prosta implementacja relacji wielu do wielu)
  friends       User[]    @relation("UserFriends")
  friendOf      User[]    @relation("UserFriends")

  sentRequests     FriendRequest[] @relation("SentRequests")
  receivedRequests FriendRequest[] @relation("ReceivedRequests")
  notifications    Notification[] @relation("UserNotifications")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model FriendRequest {
  id         String        @id @default(cuid())
  senderId   String
  receiverId String
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  sender     User          @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User          @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  // Blokada przed wysyłaniem wielu zaproszeń (spamu) do tej samej osoby
  @@unique([senderId, receiverId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   // ID użytkownika, który ma otrzymać powiadomienie
  message   String   @db.Text
  link      String?  // Opcjonalny link (np. do profilu osoby, która próbowała zarezerwować)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
}